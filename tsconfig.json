{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["express"],
    "typeRoots": ["./src/types", "./node_modules/@types"] // Add this line
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "migrations/**/*.ts"],
  "files": ["./src/types/express.d.ts"]
}